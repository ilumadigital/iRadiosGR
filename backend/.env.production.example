# TEMPLATE ONLY - do not commit real values
APP_ENV=production
NODE_ENV=production
FRONTEND_URL=https://play.iradios.gr
PORT=5011
IRADIOS_GATEWAY_ENV=production
IRADIOS_BILLING_ENABLED=0
# Do not enable until Gateway play routing, data/entitlements and webhook signature are verified.
IRADIOS_PRODUCTION_CUTOVER_APPROVED=0
ILUMA_GATEWAY_PROD_KEY=
ILUMA_GATEWAY_PROD_SECRET=
# Enable financial billing emails only after the outbox is reconciled at cutover.
PRODUCTION_BILLING_EMAILS_ENABLED=0
# Real outbound SMTP, never Mailpit and never Ethereal in production.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# JWT_SECRET, VAPID keys, ADMIN_2FA_*, and other app secrets go in private backend.env.
# MONGO_URI is supplied by compose.prod.yml and must never point to staging.
