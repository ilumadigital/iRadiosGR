# No real secrets in this file. Stage secrets live on Hostinger only.
APP_ENV=staging
NODE_ENV=production
FRONTEND_URL=https://stage.iradios.gr
PORT=5011
# MONGO_URI injected by Docker compose from separate secret
# JWT_SECRET: generated uniquely per stage
# VAPID public/private keys: generated uniquely per stage
STRIPE_SECRET_KEY=sk_test_disabled_no_live_payments
STRIPE_WEBHOOK_SECRET=whsec_disabled
SMTP_HOST=mailpit
SMTP_PORT=1025
MAIL_FROM=staging@invalid.example
ADMIN_EMAIL=staging@invalid.example

# Optional stage-only cloud recognition (off until explicitly configured).
# Obtain dedicated ACRCloud staging credentials; never commit real values.
STAGE_ENABLE_ACRCLOUD=0
# ACRCLOUD_HOST=identify-your-region.acrcloud.com
# ACRCLOUD_ACCESS_KEY=
# ACRCLOUD_ACCESS_SECRET=

# Automatic Top-10 music recognition is independently OFF until operator opt-in.
# Requires STAGE_ENABLE_ACRCLOUD=1, valid project credentials, and a deliberate
# review of ACRCloud quota/pricing. Never enable on production by accident.
STAGE_ENABLE_AUTO_ACRCLOUD=0
# Persistent Mongo daily limit. Hard-capped at 2880, the theoretical maximum
# 10 music stations x one attempt every 5 minutes x 24 hours.
STAGE_AUTO_ACR_DAILY_LIMIT=2880
