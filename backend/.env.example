# No real secrets in this file. Stage secrets live on Hostinger only.
APP_ENV=staging
NODE_ENV=production
FRONTEND_URL=https://stage.iradios.gr
PORT=5011
# MONGO_URI injected by Docker compose from separate secret
# JWT_SECRET: generated uniquely per stage
# VAPID public/private keys: generated uniquely per stage
SMTP_HOST=mailpit
SMTP_PORT=1025
MAIL_FROM=staging@invalid.example
ADMIN_EMAIL=staging@invalid.example
# Admin second-factor codes are also captured by private Mailpit.
# Public /dev/mail/ must remain HTTP 403; access via authenticated SSH.
# Do not configure external SMTP for staging.

# Manual ACRCloud Identify API v1 (server-side only, never in Vite/frontend).
# Set STAGE_ENABLE_ACRCLOUD=1 only after adding real values to the Hostinger
# staging backend.env; no scheduled/automatic ACR calls will be made.
STAGE_ENABLE_ACRCLOUD=0
ACRCLOUD_HOST=identify-eu-west-1.acrcloud.com
ACRCLOUD_ACCESS_KEY=
ACRCLOUD_ACCESS_SECRET=
# Get the host, Access Key and Access Secret from your own ACRCloud project.
# Do not include https:// or /v1/identify in ACRCLOUD_HOST.
# Requires ffmpeg (with libmp3lame) on the backend host/container.
# Now Playing: 4 minutes. Station playlist: rolling last 30 minutes.

# Nexi Sandbox Phase 3 — disabled until credentials and Gateway stage product exist.
# These values are BACKEND ONLY. Do not place keys in VITE_ variables.
# Use a staging key + its matching raw HEX secret from gateway.iluma.gr/ilm-admin.
# Gateway Staging must contain product L-PREM = 399 cents EUR.
IRADIOS_BILLING_SANDBOX_ENABLED=0
ILUMA_GATEWAY_STAGING_KEY=
ILUMA_GATEWAY_STAGING_SECRET=
# ADV-BUDGET reuses this same signed staging Gateway checkout.
# No separate advertising payment flag. Staging default VAT 24% is Admin-editable;
# paid advertising delivery remains separately disabled.
# IMPORTANT: automatic renewals/MIT are NOT implemented or enabled.

# Event-based Advertising v2 (internal real accounting, Gateway stays Sandbox).
# Keep OFF until the staging MongoDB replica-set migration has a verified backup,
# a trusted GEO ingress is working and end-to-end sandbox ledger tests pass.
ADVERTISING_V2_FINANCIAL_DELIVERY_ENABLED=0
# Generate two DIFFERENT 64-character secrets using openssl rand -hex 32.
# Private backend.env only; never use VITE_* or commit any secret.
ADVERTISING_V2_DELIVERY_SECRET=
IRADIOS_TRUSTED_GEO_SECRET=
# Legacy QA preview defaults OFF in compose.stage.yml. Re-enable only during
# explicitly non-billable testing, NEVER together with event-based settlement.

# Cloudflare Turnstile (same widget applies to login and registrations).
# The public site key is served by GET /api/auth/turnstile-config.
# Keep the SECRET only in the backend.env. Do not use Cloudflare test keys on public staging.
# Both values must belong to a Turnstile widget authorized for stage.iradios.gr.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
