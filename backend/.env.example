# No real secrets in this file. Stage secrets live on Hostinger only.
APP_ENV=staging
NODE_ENV=production
FRONTEND_URL=https://stage.iradios.gr
PORT=5011
# MONGO_URI injected by Docker compose from separate secret
# JWT_SECRET: generated uniquely per stage
# VAPID public/private keys: generated uniquely per stage
STRIPE_SECRET_KEY=sk_test_disabled_no_live_payments
STRIPE_WEBHOOK_SECRET=whsec_disabled
SMTP_HOST=mailpit
SMTP_PORT=1025
MAIL_FROM=staging@invalid.example
ADMIN_EMAIL=staging@invalid.example

# Optional paid recognition. ONLY triggered by the existing manual song button.
# Keep this key in the server-only backend.env, never in frontend env or Git.
STAGE_ENABLE_SONOVAULT=0
# SONOVAULT_API_KEY=YOUR_PAID_SONOVAULT_API_KEY
# Fixed provider endpoint: https://api.sonovault.now/v1/tracks/identify
# No automatic recognition workers, ACRCloud keys, or schedules are used.
